<style>
* {
  box-sizing: border-box;
}

.orbit-page {
  width: 100%;
  min-height: 650px;
  overflow: hidden;
  position: relative;

  display: flex;
  justify-content: center;
  align-items: center;

  font-family: Arial, sans-serif;

  background:
    linear-gradient(rgba(255,255,255,.5) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.5) 1px, transparent 1px),
    linear-gradient(135deg, #ffb6d9, #ff75b5, #ffd9e9);

  background-size: 35px 35px, 35px 35px, 100% 100%;

  border-radius: 25px;

  perspective: 1000px;
}


/* =========================
   3D ORBIT
========================= */

.scene {
  position: absolute;

  top: 30px;

  width: 250px;
  height: 250px;

  perspective: 900px;

  pointer-events: none;
}

.orbit {
  position: absolute;

  width: 230px;
  height: 230px;

  left: 10px;
  top: 10px;

  border: 2px solid rgba(255,255,255,.75);

  border-radius: 50%;

  transform-style: preserve-3d;

  animation: orbitSpin 7s linear infinite;
}

.orbit.two {
  transform: rotateX(65deg);
  animation-duration: 9s;
}

.orbit.three {
  transform: rotateY(65deg);
  animation-duration: 11s;
}


@keyframes orbitSpin {

  from {
    transform:
      rotateX(65deg)
      rotateZ(0deg);
  }

  to {
    transform:
      rotateX(65deg)
      rotateZ(360deg);
  }

}


/* =========================
   3D HEART
========================= */

.heart3d {
  position: absolute;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%)
    rotate(-45deg);

  width: 75px;
  height: 75px;

  background: #ff1685;

  filter:
    drop-shadow(
      0 15px 20px rgba(190,0,90,.4)
    );

  animation:
    heartFloat 2.5s ease-in-out infinite;

  z-index: 5;
}

.heart3d::before,
.heart3d::after {

  content: "";

  position: absolute;

  width: 75px;
  height: 75px;

  background: #ff1685;

  border-radius: 50%;

}

.heart3d::before {
  top: -37px;
  left: 0;
}

.heart3d::after {
  left: 37px;
  top: 0;
}


@keyframes heartFloat {

  0%,100% {
    transform:
      translate(-50%, -50%)
      rotate(-45deg)
      scale(1);
  }

  50% {
    transform:
      translate(-50%, -58%)
      rotate(-45deg)
      scale(1.12);
  }

}


/* =========================
   GLOW
========================= */

.glow {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 130px;
  height: 130px;

  transform:
    translate(-50%, -50%);

  border-radius: 50%;

  background:
    rgba(255,30,140,.3);

  filter: blur(30px);

  animation: glowPulse 2s infinite;

}


@keyframes glowPulse {

  0%,100% {
    transform:
      translate(-50%, -50%)
      scale(.8);

    opacity: .4;
  }

  50% {
    transform:
      translate(-50%, -50%)
      scale(1.3);

    opacity: .8;
  }

}


/* =========================
   MAIN CARD
========================= */

.pagol-card {

  width: min(430px, 92%);

  margin-top: 170px;

  padding: 28px 22px;

  text-align: center;

  background:
    rgba(255,255,255,.92);

  backdrop-filter: blur(15px);

  border-radius: 28px;

  box-shadow:
    0 25px 70px rgba(190,30,100,.3),
    0 5px 20px rgba(0,0,0,.12);

  position: relative;

  z-index: 20;

  animation:
    cardAppear .8s ease;

}


@keyframes cardAppear {

  from {
    opacity: 0;
    transform:
      translateY(30px)
      scale(.85);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }

}


/* =========================
   QUESTION
========================= */

.pagol-question {

  font-size:
    clamp(28px, 8vw, 42px);

  color: #e91e73;

  font-weight: 800;

  margin:
    5px 0 25px;

}


/* SUMAIYA */

.sumaiya-name {

  display: inline-block;

  font-weight: 900;

  background:
    linear-gradient(
      90deg,
      #c2185b,
      #ff1493,
      #9c27b0,
      #ff1493,
      #c2185b
    );

  background-size: 300% 100%;

  -webkit-background-clip: text;
  background-clip: text;

  -webkit-text-fill-color: transparent;

  animation:
    sumaiyaGlow 2.5s ease-in-out infinite,
    sumaiyaShine 4s linear infinite;

}


@keyframes sumaiyaGlow {

  0%,100% {
    transform: scale(1);

    filter:
      drop-shadow(
        0 0 3px rgba(255,20,147,.2)
      );
  }

  50% {
    transform: scale(1.08);

    filter:
      drop-shadow(
        0 0 12px rgba(255,20,147,.7)
      );
  }

}


@keyframes sumaiyaShine {

  0% {
    background-position: 0% 50%;
  }

  50% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0% 50%;
  }

}


/* =========================
   BUTTONS
========================= */

.pagol-buttons {

  display: flex;

  justify-content: center;

  gap: 15px;

  min-height: 60px;

}


.pagol-btn {

  border: none;

  padding:
    14px 30px;

  border-radius: 999px;

  font-size: 18px;

  font-weight: bold;

  cursor: pointer;

  transition:
    transform .2s ease,
    box-shadow .2s ease;

}


.pagol-btn:hover {

  transform:
    scale(1.08);

}


.yes-button {

  background: #e91e73;

  color: white;

  box-shadow:
    0 8px 22px
    rgba(233,30,115,.4);

}


/* =========================
   NO BUTTON
========================= */

.no-button {

  background: white;

  color: #e91e73;

  border:
    2px solid #e91e73;

  position: fixed;

  z-index: 99999;

  transition:
    left .25s ease,
    top .25s ease,
    transform .15s ease;

}


/* =========================
   SUCCESS
========================= */

.pagol-success {

  display: none;

  animation:
    successAppear .7s ease;

}


@keyframes successAppear {

  from {
    opacity: 0;
    transform: scale(.6);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }

}


.success-emoji {

  font-size: 65px;

  animation:
    emojiBounce 1s infinite;

}


@keyframes emojiBounce {

  0%,100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.2);
  }

}


.pagol-success h2 {

  color: #e91e73;

  font-size: 32px;

  margin:
    15px 0;

}


.pagol-success p {

  color: #555;

  font-size: 18px;

}


/* MOBILE */

@media(max-width:500px) {

  .orbit-page {
    min-height: 620px;
  }

  .scene {
    transform: scale(.85);
    top: 15px;
  }

  .pagol-card {
    margin-top: 155px;
  }

}
</style>


<div class="orbit-page">

  <!-- 3D ANIMATION -->

  <div class="scene">

    <div class="glow"></div>

    <div class="orbit"></div>

    <div class="orbit two"></div>

    <div class="orbit three"></div>

    <div class="heart3d"></div>

  </div>


  <!-- MAIN CARD -->

  <div class="pagol-card">

    <div id="pagolQuestion">

      <div class="pagol-question">

        <span class="sumaiya-name">
          sumaiya
        </span>

        tui ki pagol? 😹

      </div>


      <div class="pagol-buttons">

        <button
          class="pagol-btn yes-button"
          id="pagolYes">

          Yes 😎

        </button>


        <button
          class="pagol-btn no-button"
          id="pagolNo">

          No 🙃

        </button>

      </div>

    </div>


    <!-- SUCCESS -->

    <div
      class="pagol-success"
      id="pagolSuccess">

      <div class="success-emoji">
        😂
      </div>

      <h2>
        HAHA! I KNEW IT! 😹
      </h2>

      <p>
        Tui je pagol, eta confirm! 🤣
      </p>

    </div>

  </div>

</div>


<script>

(function() {

  const noButton =
    document.getElementById("pagolNo");

  const yesButton =
    document.getElementById("pagolYes");

  const question =
    document.getElementById("pagolQuestion");

  const success =
    document.getElementById("pagolSuccess");


  /* NO BUTTON ESCAPE */

  function moveNoButton() {

    const padding = 15;

    const width =
      noButton.offsetWidth;

    const height =
      noButton.offsetHeight;


    const maxX =
      window.innerWidth -
      width -
      padding;


    const maxY =
      window.innerHeight -
      height -
      padding;


    const x =
      padding +
      Math.random() *
      Math.max(1, maxX - padding);


    const y =
      padding +
      Math.random() *
      Math.max(1, maxY - padding);


    noButton.style.left =
      x + "px";


    noButton.style.top =
      y + "px";


    noButton.style.transform =
      "rotate(" +
      ((Math.random() * 20) - 10) +
      "deg)";

  }


  noButton.addEventListener(
    "mouseenter",
    moveNoButton
  );


  noButton.addEventListener(
    "pointerdown",
    function(e) {

      e.preventDefault();

      moveNoButton();

    }
  );


  noButton.addEventListener(
    "click",
    function(e) {

      e.preventDefault();

      moveNoButton();

    }
  );


  /* YES */

  yesButton.addEventListener(
    "click",
    function() {

      question.style.display =
        "none";

      noButton.style.display =
        "none";

      success.style.display =
        "block";

    }
  );


})();

</script>
