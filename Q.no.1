<style>
  * {
    box-sizing: border-box;
  }

  .pagol-page {
    width: 100%;
    min-height: 650px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 25px 15px;
    overflow: hidden;
    position: relative;

    font-family: Arial, sans-serif;

    background:
      linear-gradient(rgba(255,255,255,.55) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.55) 1px, transparent 1px),
      linear-gradient(135deg, #ffb6d9, #ff80bb, #ffd8e9);

    background-size:
      35px 35px,
      35px 35px,
      100% 100%;

    border-radius: 25px;
  }

  .pagol-card {
    width: min(430px, 95%);
    padding: 22px;
    text-align: center;

    background: rgba(255,255,255,.9);
    backdrop-filter: blur(12px);

    border-radius: 28px;

    box-shadow:
      0 20px 60px rgba(190,30,100,.25),
      0 5px 20px rgba(0,0,0,.12);

    animation: cardAppear .8s ease;
    position: relative;
    z-index: 5;
  }

  @keyframes cardAppear {
    from {
      opacity: 0;
      transform: scale(.85) translateY(30px);
    }

    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* IMAGE */

  .pagol-image {
    width: 100%;
    height: 270px;

    object-fit: cover;

    border-radius: 20px;

    display: block;

    margin-bottom: 22px;

    box-shadow:
      0 10px 30px rgba(0,0,0,.18);

    animation: imageFloat 3s ease-in-out infinite;
  }

  @keyframes imageFloat {

    0%,100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }

  }

  /* QUESTION */

  .pagol-question {

    font-size: clamp(28px, 8vw, 42px);

    color: #e91e73;

    font-weight: 800;

    margin: 10px 0 25px;

  }

  /* SUMAIYA */

  .sumaiya-name {

    display: inline-block;

    font-weight: 900;

    background:
      linear-gradient(
        90deg,
        #c2185b,
        #ff1493,
        #9c27b0,
        #ff1493,
        #c2185b
      );

    background-size: 300% 100%;

    -webkit-background-clip: text;
    background-clip: text;

    -webkit-text-fill-color: transparent;

    animation:
      sumaiyaGlow 2.5s ease-in-out infinite,
      sumaiyaShine 4s linear infinite;

  }

  @keyframes sumaiyaGlow {

    0%,100% {
      transform: scale(1);
      filter:
        drop-shadow(
          0 0 2px rgba(255,20,147,.2)
        );
    }

    50% {
      transform: scale(1.08);
      filter:
        drop-shadow(
          0 0 12px rgba(255,20,147,.65)
        );
    }

  }

  @keyframes sumaiyaShine {

    0% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }

    100% {
      background-position: 0% 50%;
    }

  }

  /* BUTTONS */

  .pagol-buttons {

    display: flex;

    justify-content: center;

    gap: 15px;

    min-height: 60px;

  }

  .pagol-btn {

    border: none;

    padding: 14px 30px;

    border-radius: 999px;

    font-size: 18px;

    font-weight: bold;

    cursor: pointer;

    transition:
      transform .2s ease,
      box-shadow .2s ease;

  }

  .pagol-btn:hover {
    transform: scale(1.08);
  }

  .yes-button {

    background: #e91e73;

    color: white;

    box-shadow:
      0 8px 20px rgba(233,30,115,.35);

  }

  /* NO BUTTON */

  .no-button {

    background: white;

    color: #e91e73;

    border: 2px solid #e91e73;

    position: fixed;

    z-index: 99999;

    transition:
      left .25s ease,
      top .25s ease,
      transform .15s ease;

  }

  /* SUCCESS */

  .pagol-success {

    display: none;

    animation: successAppear .7s ease;

  }

  @keyframes successAppear {

    from {
      opacity: 0;
      transform: scale(.6);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }

  }

  .success-emoji {

    font-size: 65px;

    animation:
      emojiBounce 1s infinite;

  }

  @keyframes emojiBounce {

    0%,100% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.2);
    }

  }

  .pagol-success h2 {

    color: #e91e73;

    font-size: 32px;

    margin: 15px 0;

  }

  .pagol-success p {

    color: #555;

    font-size: 18px;

  }

</style>


<div class="pagol-page">

  <div class="pagol-card">

    <!-- QUESTION -->

    <div id="pagolQuestion">

      <!-- IMAGE -->
      <img
        class="pagol-image"
        src="PASTE_YOUR_IMAGE_URL_HERE"
        alt="Funny cat"
      >

      <!-- QUESTION -->

      <div class="pagol-question">

        <span class="sumaiya-name">
          sumaiya
        </span>

        tui ki pagol? 😹

      </div>


      <!-- BUTTONS -->

      <div class="pagol-buttons">

        <button
          class="pagol-btn yes-button"
          id="pagolYes">

          Yes 😎

        </button>

        <button
          class="pagol-btn no-button"
          id="pagolNo">

          No 🙃

        </button>

      </div>

    </div>


    <!-- SUCCESS -->

    <div
      class="pagol-success"
      id="pagolSuccess">

      <div class="success-emoji">
        😂
      </div>

      <h2>
        HAHA! I KNEW IT! 😹
      </h2>

      <p>
        Tui je pagol, eta confirm! 🤣
      </p>

    </div>

  </div>

</div>


<script>

(function() {

  const noButton =
    document.getElementById("pagolNo");

  const yesButton =
    document.getElementById("pagolYes");

  const question =
    document.getElementById("pagolQuestion");

  const success =
    document.getElementById("pagolSuccess");


  /* MOVE NO BUTTON */

  function moveNoButton() {

    const padding = 15;

    const width =
      noButton.offsetWidth;

    const height =
      noButton.offsetHeight;


    const maxX =
      window.innerWidth -
      width -
      padding;


    const maxY =
      window.innerHeight -
      height -
      padding;


    const x =
      padding +
      Math.random() *
      Math.max(1, maxX - padding);


    const y =
      padding +
      Math.random() *
      Math.max(1, maxY - padding);


    noButton.style.left =
      x + "px";


    noButton.style.top =
      y + "px";


    const rotation =
      (Math.random() * 20) - 10;


    noButton.style.transform =
      "rotate(" +
      rotation +
      "deg)";

  }


  /*
    DESKTOP:
    Mouse approaches NO button
  */

  noButton.addEventListener(
    "mouseenter",
    moveNoButton
  );


  /*
    MOBILE:
    Touching NO button makes it escape
  */

  noButton.addEventListener(
    "pointerdown",
    function(event) {

      event.preventDefault();

      moveNoButton();

    }
  );


  noButton.addEventListener(
    "click",
    function(event) {

      event.preventDefault();

      moveNoButton();

    }
  );


  /* YES */

  yesButton.addEventListener(
    "click",
    function() {

      question.style.display =
        "none";

      noButton.style.display =
        "none";

      success.style.display =
        "block";

      createConfetti();

    }
  );


  /* CONFETTI */

  function createConfetti() {

    for (
      let i = 0;
      i < 60;
      i++
    ) {

      const piece =
        document.createElement("div");


      piece.style.position =
        "fixed";

      piece.style.width =
        "8px";

      piece.style.height =
        "8px";

      piece.style.borderRadius =
        "3px";

      piece.style.background =
        [
          "#e91e73",
          "#ff1493",
          "#ff80ab",
          "#ffffff",
          "#9c27b0"
        ][
          Math.floor(
            Math.random() * 5
          )
        ];


      piece.style.left =
        Math.random() * 100 +
        "vw";


      piece.style.top =
        "-10px";


      piece.style.zIndex =
        "999999";


      document.body.appendChild(
        piece
      );


      const duration =
        1500 +
        Math.random() * 1800;


      piece.animate(

        [
          {
            transform:
              "translateY(0) rotate(0deg)",
            opacity: 1
          },

          {
            transform:
              "translateY(110vh) rotate(720deg)",
            opacity: 0
          }
        ],

        {
          duration:
            duration,

          easing:
            "cubic-bezier(.2,.8,.3,1)"
        }

      );


      setTimeout(
        () => piece.remove(),
        duration
      );

    }

  }

})();

</script>
